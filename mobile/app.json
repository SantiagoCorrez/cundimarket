{
  "expo": {
    "name": "CundiMarket",
    "slug": "cundimarket",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cundimarket",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "co.cundimarket.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.cundimarket.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#055FAD",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#055FAD",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 288
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CundiMarket usa tu ubicación para mostrarte los comercios más cercanos."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "02c9e418-d316-4c45-997b-8aad21cf31cd"
      }
    }
  }
}
